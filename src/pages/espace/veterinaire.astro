---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Espace Vétérinaire · VetCare Plus">
  <div class="dash" id="dashContent">Chargement…</div>

  <script is:inline>
    (function () {
      var u = window.vcRequireRole('veterinaire');
      if (!u) return;

      Promise.all([
        fetch(window.VC_API).then(function (r) { return r.json(); }).catch(function () { return null; }),
        fetch(window.VC_API_PATIENTS).then(function (r) { return r.json(); }).catch(function () { return { patients: [] }; })
      ]).then(function (res) {
        var data = res[0];
        var patients = (res[1].patients || []).filter(function (p) { return p.veterinaire === u.identity; });
        var c = document.getElementById('dashContent');

        var planning = ((data && data.planning_today) || []).filter(function (r) { return r.veterinaire === u.identity; });
        var prows = planning.length
          ? planning.map(function (r) { return '<tr><td>' + r.heure + '</td><td>' + r.client + '</td><td>' + r.animal + '</td><td>' + r.motif + '</td></tr>'; }).join('')
          : '<tr><td colspan="4" style="color:var(--muted)">Aucun rendez-vous pour vous aujourd’hui</td></tr>';

        var patRows = patients.length
          ? patients.map(function (p) { return '<tr><td><b>' + p.nom + '</b> (' + p.espece + ')</td><td>' + p.proprietaire + '</td><td>' + (p.soins[0] ? p.soins[0].type + ' · ' + p.soins[0].date : 'aucun') + '</td></tr>'; }).join('')
          : '<tr><td colspan="3" style="color:var(--muted)">Aucun patient rattaché</td></tr>';

        var notes = patients.length
          ? patients.map(function (p) { return '<div class="conseil"><b>' + p.nom + '</b> : ' + p.antecedents + '</div>'; }).join('')
          : '<p style="color:var(--muted);font-size:.9rem">Aucune note pour le moment.</p>';

        c.innerHTML = '<h1>Espace Vétérinaire</h1><div class="sub">' + u.name + ' · ' + (data ? data.today : '') + '</div>'
          + '<div class="panel"><h3>📅 Mon planning du jour <span style="font-size:.7rem;color:var(--sea)">● live</span></h3>'
          + '<table><tr><th>Heure</th><th>Client</th><th>Animal</th><th>Motif</th></tr>' + prows + '</table></div>'
          + '<div class="grid2"><div class="panel"><h3>Mes patients</h3>'
          + '<table><tr><th>Animal</th><th>Propriétaire</th><th>Dernier soin</th></tr>' + patRows + '</table></div>'
          + '<div class="panel"><h3>Notes cliniques</h3>' + notes
          + '<p style="color:var(--muted);font-size:.88rem;margin-top:12px">💬 Demandez à l’assistant votre planning ou les disponibilités.</p></div></div>';
      });
    })();
  </script>
</Layout>
