---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Espace Patient · VetCare Plus">
  <div class="dash" id="dashContent">Chargement…</div>

  <script is:inline>
    (function () {
      var u = window.vcRequireRole('patient');
      if (!u) return;

      var soinsRows = function (p) {
        if (!p.soins || !p.soins.length) return '<tr><td colspan="2" style="color:var(--muted)">Aucun soin enregistré</td></tr>';
        return p.soins.map(function (s) {
          return '<tr><td>' + s.date + '</td><td><b>' + s.type + '</b><br>'
            + '<span style="color:var(--muted);font-size:.85rem">' + s.notes + '</span></td></tr>';
        }).join('');
      };

      var animalPanel = function (p) {
        return '<div class="panel"><h3>' + p.nom + ' <span style="font-weight:400;color:var(--muted);font-size:.85rem">· ' + p.espece + ' (' + p.race + '), né en ' + p.naissance + '</span></h3>'
          + '<p style="color:var(--muted);font-size:.9rem;margin:0 0 10px">Vétérinaire référent : ' + (p.veterinaire || 'non renseigné') + '</p>'
          + '<div class="conseil">🩺 <b>Suivi en cours :</b> ' + p.antecedents + '</div>'
          + '<h3 style="margin-top:16px;font-size:1rem">Historique des soins</h3>'
          + '<table><tr><th>Date</th><th>Soin</th></tr>' + soinsRows(p) + '</table></div>';
      };

      fetch(window.VC_API_PATIENTS).then(function (r) { return r.json(); }).then(function (pd) {
        var all = pd.patients || [];
        var mine = all.filter(function (x) { return x.proprietaire === u.name; });
        var c = document.getElementById('dashContent');
        if (!mine.length) {
          c.innerHTML = '<h1>Bonjour ' + u.name + ' 🐾</h1><div class="sub">Votre espace patient</div>'
            + '<div class="panel">Aucun animal rattaché à votre compte pour le moment.</div>';
          return;
        }
        var intro = '<h1>Bonjour ' + u.name + ' 🐾</h1><div class="sub">Votre espace patient · '
          + mine.length + (mine.length > 1 ? ' animaux suivis' : ' animal suivi') + '</div>';
        var animalsHtml = mine.map(animalPanel).join('');
        var aside = '<div class="panel"><h3>Conseils personnalisés</h3>'
          + '<div class="conseil">🦟 Antiparasitaire à renouveler avant l’été.</div>'
          + '<div class="conseil">🍽️ Alimentation adaptée au poids et à l’âge de vos animaux.</div>'
          + '<div class="conseil">📅 Pensez aux prochains rappels vaccinaux.</div>'
          + '<h3 style="margin-top:18px;font-size:1rem">Une question ?</h3>'
          + '<p style="color:var(--muted);font-size:.9rem">Utilisez l’assistant en bas à droite : connecté, il peut répondre sur vos propres animaux et vous proposer un rendez-vous.</p></div>';
        c.innerHTML = intro + '<div class="grid2"><div>' + animalsHtml + '</div><div>' + aside + '</div></div>';
      }).catch(function () {
        document.getElementById('dashContent').innerHTML = '<div class="panel">Données indisponibles pour le moment, réessayez dans un instant.</div>';
      });
    })();
  </script>
</Layout>
