---
import Layout from '../layouts/Layout.astro';
import { SERVICES } from '../data/services.js';
import { ICONS } from '../data/icons.js';
---
<Layout>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="kicker">🐾 Clinique vétérinaire · Paris</span>
        <h1>La santé de vos animaux,<br>en toute confiance</h1>
        <p>8 vétérinaires, un accompagnement complet : vaccins, soins, urgences, conseils du quotidien. Et un assistant en ligne, disponible 24/7.</p>
        <div class="hero-actions">
          <a class="btn amber" href="#" onclick="vcOpenChat();return false;">Poser une question à l'assistant</a>
          <a class="btn ghost-light" href="/connexion">Accéder à mon espace</a>
        </div>
        <div class="hero-stats">
          <div><b>8</b>vétérinaires</div>
          <div><b>24/7</b>urgences</div>
          <div><b>6</b>espèces suivies</div>
        </div>
        <p style="margin:22px 0 0"><a href="/comment-ca-marche" style="color:#fff;opacity:.85;font-size:.86rem;text-decoration:underline">Curieux de savoir comment fonctionne l'assistant ? →</a></p>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="blob"></div>
        <svg class="blob-paw" width="150" height="150" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="20" cy="26" rx="8" ry="6.6" fill="#fff" fill-opacity=".95"/>
          <ellipse cx="9.8" cy="17.4" rx="3.6" ry="4.6" fill="#fff" fill-opacity=".95" transform="rotate(-18 9.8 17.4)"/>
          <ellipse cx="17" cy="10.8" rx="3.6" ry="4.8" fill="#fff" fill-opacity=".95" transform="rotate(-6 17 10.8)"/>
          <ellipse cx="24.4" cy="10.6" rx="3.6" ry="4.8" fill="#fff" fill-opacity=".95" transform="rotate(6 24.4 10.6)"/>
          <ellipse cx="31" cy="17.2" rx="3.6" ry="4.6" fill="#fff" fill-opacity=".95" transform="rotate(18 31 17.2)"/>
        </svg>
        <div class="floating-card"><span class="dot"></span>Créneaux disponibles cette semaine</div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cards">
      {SERVICES.map((service) => (
        <a class="card" href={`/services/${service.slug}`}>
          <div class="card-icon" set:html={ICONS[service.icon]} />
          <h3>{service.title}</h3><p>{service.tagline}</p>
          <span class="card-toggle">En savoir plus <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span>
        </a>
      ))}
    </div>

    <div class="demo-access">
      <div class="section-kicker">Essayer la démo</div>
      <h2 class="demo-title">Explorez les 3 espaces en un clic</h2>
      <p class="demo-lead">Aucune inscription : choisissez un profil, vous entrez directement dans son espace. Les données sont fictives, à but de démonstration.</p>
      <div class="demo-cards">
        <div class="card demo-card">
          <div class="card-icon">🐾</div>
          <h3>Espace Patient</h3>
          <p>Le dossier de vos animaux, l'historique des soins et vos conseils personnalisés.</p>
          <button class="btn demo-btn" onclick="vcQuickLogin('patient@vetcare.fr')">Entrer comme patient</button>
        </div>
        <div class="card demo-card">
          <div class="card-icon">🩺</div>
          <h3>Espace Vétérinaire</h3>
          <p>Vos patients, votre planning et l'assistant clinique au service du soin.</p>
          <button class="btn demo-btn" onclick="vcQuickLogin('veto@vetcare.fr')">Entrer comme vétérinaire</button>
        </div>
        <div class="card demo-card">
          <div class="card-icon">🏛️</div>
          <h3>Espace Direction</h3>
          <p>Le pilotage de l'activité : tableau de bord, triage des demandes et supervision.</p>
          <button class="btn demo-btn" onclick="vcQuickLogin('directeur@vetcare.fr')">Entrer comme direction</button>
        </div>
      </div>
      <p class="demo-note">Vous préférez saisir des identifiants ? <a href="/connexion">Aller à la page de connexion →</a></p>
    </div>

    <div class="video-section">
      <div class="section-kicker">VetCare Plus en une minute</div>
      <video
        src="/videos/vetcare-presentation.mp4"
        poster="/videos/vetcare-presentation-poster.jpg"
        aria-label="Vidéo de présentation de VetCare Plus, une minute, sous-titrée"
        controls
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>

    <div class="info-section">
      <div class="section-kicker">Infos pratiques</div>
      <div class="info-grid">
        <div class="info-card">
          <div class="info-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></div>
          <div><h4>Horaires</h4><p>Lun–Ven : 8h30–19h<br>Samedi : 9h–13h<br>Urgences : 7j/7</p></div>
        </div>
        <div class="info-card">
          <div class="info-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 6.5 12 13 21 6.5"/></svg></div>
          <div><h4>Contact</h4><p>01 23 45 67 89<br>contact@vetcareplus.fr</p></div>
        </div>
        <div class="info-card">
          <div class="info-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-7.58 7-12a7 7 0 0 0-14 0c0 4.42 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></div>
          <div><h4>Adresse</h4><p>12 rue des Lilas<br>75000 Paris</p></div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .demo-access { text-align: center; margin: 60px auto 8px; }
  .demo-title { font-size: 1.6rem; margin: 0 0 8px; color: var(--ink); }
  .demo-lead { color: var(--muted); max-width: 580px; margin: 0 auto 30px; font-size: .95rem; }
  .demo-cards { display: flex; gap: 18px; flex-wrap: wrap; justify-content: center; }
  .demo-cards .card { flex: 1 1 240px; max-width: 290px; text-align: left; }
  .demo-cards .card-icon { font-size: 1.5rem; }
  .demo-btn { width: 100%; margin-top: 16px; }
  .demo-note { margin-top: 26px; font-size: .88rem; color: var(--muted); }
  .demo-note a { color: var(--teal); font-weight: 600; text-decoration: none; }
  .demo-note a:hover { text-decoration: underline; }
</style>
