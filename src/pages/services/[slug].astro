---
import Layout from '../../layouts/Layout.astro';
import { SERVICES } from '../../data/services.js';
import { ICONS } from '../../data/icons.js';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const checkIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>';
---
<Layout title={service.title + ' — VetCare Plus'} description={service.intro}>
  <div class="wrap" style="padding-top:32px">
    <div class="breadcrumb"><a href="/">Accueil</a> / {service.title}</div>

    <div class="service-header">
      <div class="service-icon-lg" set:html={ICONS[service.icon]} />
      <div>
        <h1>{service.title}</h1>
        <p class="tagline">{service.tagline}</p>
      </div>
    </div>

    <p class="service-intro">{service.intro}</p>

    <h2 class="section-title">Ce qui est inclus</h2>
    <ul class="check-list">
      {service.inclus.map((item) => (
        <li><span set:html={checkIcon} />{item}</li>
      ))}
    </ul>

    {service.deroule.length > 0 && (
      <>
        <h2 class="section-title">Déroulé type</h2>
        <div class="steps">
          {service.deroule.map((etape, i) => (
            <div class="step">
              <div class="step-n">{i + 1}</div>
              <div><h4>{etape.titre}</h4><p>{etape.texte}</p></div>
            </div>
          ))}
        </div>
      </>
    )}

    <h2 class="section-title">Questions fréquentes</h2>
    <div class="faq">
      {service.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.r}</p>
        </details>
      ))}
    </div>

    <div class="cta-panel">
      <h3>Une question, ou envie de prendre rendez-vous ?</h3>
      <p>Notre assistant en ligne peut vous répondre tout de suite et vous proposer des créneaux disponibles.</p>
      <a class="btn amber" href="#" onclick={`vcOpenChatWithMessage(${JSON.stringify(service.ctaMessage)});return false;`}>{service.ctaLabel}</a>
    </div>

    <a class="back-link" href="/" style="text-align:left;margin:0 0 60px">← Retour à l'accueil</a>
  </div>
</Layout>
