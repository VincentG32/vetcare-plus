---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Connexion · VetCare Plus">
  <section class="login-section">
    <div class="login">
      <div class="login-logo">
        <svg width="44" height="44" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="40" height="40" rx="11" fill="#028090"/>
          <ellipse cx="20" cy="26" rx="8" ry="6.6" fill="#fff"/>
          <ellipse cx="9.8" cy="17.4" rx="3.6" ry="4.6" fill="#fff" transform="rotate(-18 9.8 17.4)"/>
          <ellipse cx="17" cy="10.8" rx="3.6" ry="4.8" fill="#fff" transform="rotate(-6 17 10.8)"/>
          <ellipse cx="24.4" cy="10.6" rx="3.6" ry="4.8" fill="#fff" transform="rotate(6 24.4 10.6)"/>
          <ellipse cx="31" cy="17.2" rx="3.6" ry="4.6" fill="#fff" transform="rotate(18 31 17.2)"/>
        </svg>
      </div>
      <h2>Espace connecté</h2>
      <div class="sub">Accédez à votre espace patient, vétérinaire ou direction.</div>
      <form onsubmit="return vcDoLogin(event)">
        <label>Email</label>
        <div class="input-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 6.5 12 13 21 6.5"/></svg>
          <input id="email" type="email" placeholder="vous@vetcareplus.fr" autocomplete="username" />
        </div>
        <label>Mot de passe</label>
        <div class="input-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M7.5 10V7a4.5 4.5 0 0 1 9 0v3"/></svg>
          <input id="password" type="password" placeholder="••••••" autocomplete="current-password" />
        </div>
        <button class="btn" type="submit">Se connecter</button>
        <div class="err" id="loginErr"></div>
      </form>
      <div class="demo-hint">
        <b>Comptes de démonstration <span style="font-weight:500">(mot de passe : demo)</span></b>
        <span class="demo-chip">patient@vetcare.fr</span>
        <span class="demo-chip">veto@vetcare.fr</span>
        <span class="demo-chip">directeur@vetcare.fr</span>
      </div>
      <a class="back-link" href="/">← Retour à l'accueil</a>
    </div>
  </section>

  <script is:inline>
    // Déjà connecté : direct vers son espace, pas besoin de re-remplir le formulaire.
    (function () {
      var u = window.vcCurrentUser && window.vcCurrentUser();
      if (u) location.href = '/espace/' + u.role;
    })();
  </script>
</Layout>
